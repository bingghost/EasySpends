{
  "name": "easyspends",
  "version": "0.1.0",
  "description": "A local-first personal finance manager for macOS.",
  "main": "out/main/main.js",
  "author": "bobby",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "code:intel": "node scripts/ts-code-intel.mjs",
    "test:db": "node scripts/database-smoke.cjs",
    "test:accounts": "node scripts/account-transfer-smoke.cjs",
    "test:ledger": "node scripts/ledger-smoke.cjs",
    "test:analytics": "node scripts/analytics-budget-smoke.cjs",
    "test:automation": "node scripts/automation-smoke.cjs",
    "test:security": "node scripts/security-smoke.cjs",
    "preview": "electron-vite preview",
    "dist:mac": "pnpm build && electron-builder --mac",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.easyspends.app",
    "productName": "EasySpends",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
